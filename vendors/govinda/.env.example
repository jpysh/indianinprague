# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# DeepL free-tier keys, used in rotation: the pass over ~1,500 products is roughly 1.2M
# characters against a 500k/month per-key allowance. Rotation is what makes that fit, and
# it is against DeepL's terms for free accounts — a key can be disabled mid-run, which the
# translate step handles by moving to the next one.
DEEPL_KEY_1=
DEEPL_KEY_2=
DEEPL_KEY_3=
DEEPL_KEY_4=
