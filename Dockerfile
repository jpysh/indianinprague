# indianinprague.jains.es — hand-written static HTML on nginx.
#
# Single stage, unlike /Users/webserver/code/OliveUIndia/Dockerfile: that site is
# generated by Astro and has to build inside the image, whereas these pages ARE the
# source. There is nothing to compile, so the image is just nginx plus the files.

FROM nginx:alpine

# Site content, copied by pattern rather than `COPY . .`. The wildcard still picks up a
# new page automatically — drop a .html in the project root and it ships — but nothing
# outside these patterns can reach the web root, so nginx/ and the compose files can live
# beside the site without being served.
# The bare *.txt glob picks up the IndexNow key file (<32-hex>.txt) alongside robots and
# llms, so rotating the key needs no Dockerfile change.
COPY *.html *.txt sitemap.xml /usr/share/nginx/html/
COPY assets/ /usr/share/nginx/html/assets/

# Only the derived images ship. The originals in images/ are 23 MB of straight-off-the-
# camera JPEGs (IMG_5564.JPG alone is 3.4 MB) that no page references any more — the
# markup points exclusively at images/derived/, which scripts/build-images.mjs generates.
# Copying just the derivatives keeps ~16 MB of unreachable bytes out of the image.
COPY images/derived/ /usr/share/nginx/html/images/derived/

# COPY preserves the host's mode bits, and the pages arrived here as 0600 — readable by
# the author on macOS, and a blanket 403 for the nginx worker inside the container. The
# source files have been corrected to 0644, but this normalises anything added later so a
# stray 0600 cannot silently take a page off the air.
RUN chmod -R a+rX /usr/share/nginx/html

COPY nginx/indianinprague.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf

# 8080 rather than 80 so the container needs no privileged port, matching the other sites
# on this host.
EXPOSE 8080

# Fail the health check if nginx stops serving, so a wedged worker shows up as unhealthy
# in `docker ps` instead of silently 502ing the tunnel. /healthz is excluded from the
# access log so this does not drown `docker logs`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
