.DS_Store
**/.DS_Store

# Watchdog output, regenerated on every run.
scripts/*.log

# Generated by scripts/sync-vinted.mjs — regenerate with ./scripts/publish.sh
.sync.log

# The date of the last successful publish, written by publish.sh and read by its
# --if-needed guard. Machine-local state about THIS Mac, not a fact about the site: on a
# checkout that has never published it must read as "never", which is exactly what an
# absent file means.
.sync-stamp

# Staged public site, rebuilt by scripts/build-dist.mjs on every publish.
dist/

# DeepL API keys, read by scripts/deepl.mjs. Moved here from vendors/govinda/.env when the
# client became site-wide. Never tracked; .env.example records the shape.
/.env

# npm is here only to pin wrangler (see package.json). Lockfile IS tracked; installs are not.
node_modules/

# Vendor sync (Govinda). The scraped catalogue and its photos are disposable — regenerate
# with vendors/govinda/scrape.mjs. Only YOUR decisions (data/overrides.json) are tracked,
# which is what stops a weekly re-scrape from overwriting hand-set prices and copy.
vendors/govinda/images/
vendors/govinda/*.log
# Raw scrape output: rewritten wholesale every run, and large. data/translations.json is
# NOT ignored — it is paid DeepL output and re-fetching it costs money.
vendors/govinda/data/products-raw.json
# The previous sync's state, kept only to diff against the next one. Regenerated every run;
# data/changes.json is derived from it and is worth committing, this is not.
vendors/govinda/data/snapshot.json

# Dashboard server log (launchd). Same reason scripts/*.log is ignored above.
scripts/dashboard.log

# The language trees, written by scripts/build-i18n.mjs from the English pages plus
# data/i18n/*.json. Derived, ~15 MB per language, and rebuilt on every publish — including
# in the Workers Builds container, which runs build-i18n.mjs as one of build-dist's
# generators. What IS committed is data/i18n/, the translations themselves: the source, not
# the output. Same rule as dist/.
/ru/
/fr/
/de/
/it/
/es/
/pl/
/cs/

# The last run's verdict, written by scripts/publish.sh and read by the admin dashboard.
# Machine-local state about THIS Mac, like .sync-stamp: on a fresh checkout its absence must
# read as "no run yet", not as a stale verdict copied from another machine.
.publish-status.json
PRFAQ*.md
Business case/

# The shelf card fragments, written by scripts/build-shop.mjs from data/catalog.json and
# shipped into dist/ by build-dist.mjs. Derived, rebuilt on every publish — including in the
# Workers Builds container, which runs build-shop.mjs as one of build-dist's generators.
# Same rule as /ru/ and dist/: the source is committed, the output is not. Tracked until
# 3 Sep 2026, where they were the main reason the tree was dirty after every 07:15 run.
*.cards

# The stock-taking view, written by scripts/build-inventory.mjs from data/catalog.json and
# data/archive.json. Never staged into dist/ (build-dist.mjs's PRIVATE_PAGES), never linked
# from navigation, sitemap or JSON-LD, and it holds cost prices and unlisted stock. It is
# 1.1 MB rewritten in full every morning, so tracking it bought a daily diff of that size
# and nothing else. Regenerate with ./scripts/publish.sh.
/inventory.html

# The IndexNow submission ledger, written by scripts/indexnow.mjs. Machine-local state about
# THIS Mac, like .sync-stamp: it is written at step 14, AFTER step 13 commits, deliberately
# (indexnow must follow the deploy — see publish.sh's header), so it could never ride in the
# commit that produced it and was permanently a day stale in git. Deleting it costs one
# round of re-submission, which is harmless.
data/indexnow-state.json

# Public repo: machine-local state and the owner's private admin tool stay on the Mac.
# (Already-published history is not rewritten by this.)
.wrangler/
dashboard.html
scripts/dashboard-server.mjs
scripts/indianinprague-dashboard
scripts/com.jains.indianinprague-dashboard.plist
