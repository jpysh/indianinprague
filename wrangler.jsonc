{
  // indianinprague.jains.es — a static-assets-only Worker. There is no `main` script: this
  // Worker serves files and nothing else, which is why the deployment stays on the free
  // tier without touching the 100k/day request budget that scripted Workers draw from.
  //
  // WHY WORKERS STATIC ASSETS AND NOT PAGES
  // Pages force-drops the .html extension and the behaviour is NOT configurable. Workers
  // exposes html_handling, so the choice of URL shape stays ours. That mattered on 15 Aug,
  // when the site still linked everything as .html and switching would have meant a
  // redirect on every internal click while every canonical tag still pointed at the .html
  // form — contradictory signals on every page.
  //
  // On 16 Aug the site moved to extensionless URLs deliberately, and this time the whole
  // chain moved with it: internal links, canonicals, og:url, JSON-LD, the sitemap and the
  // redirect rules. That is the difference between changing the URL shape and breaking it.
  "name": "indianinprague",
  "compatibility_date": "2026-08-15",

  "assets": {
    "directory": "./dist",

    // "auto-trailing-slash": /wardrobe is served from wardrobe.html, and the .html form is
    // redirected away. The .html suffix now exists only as a filename on disk.
    //
    // Note the built-in redirect is a 307 TEMPORARY — measured, not assumed. Every .html URL
    // here has been indexed for months, and a temporary redirect tells Google the old URL is
    // still canonical, which is the opposite of the truth. edge/_redirects therefore carries
    // an explicit 301 for each one, matched ahead of this behaviour.
    "html_handling": "auto-trailing-slash",

    // Unmatched paths get 404.html with a 404 status, matching the nginx `=404` fallthrough
    // and location = /404.html block.
    "not_found_handling": "404-page"
  }
}
